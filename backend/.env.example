
# Coffee Ninja - Example Environment Configuration
# Copy this file to .env and replace placeholders with your own values.

# Express server
PORT=5000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffee_ninja_db
DB_USER=coffee_ninja_app
DB_PASSWORD=replace_with_your_password

# JWT authentication
JWT_SECRET=replace_with_your_own_random_secret

# Development staff account (used by seedUser.js)
SEED_USER_NAME=Coffee Ninja Staff
SEED_USER_EMAIL=staff@example.com
SEED_USER_PASSWORD=replace_with_a_strong_test_password
